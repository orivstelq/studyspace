generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SpaceCategory {
  LIBRARY
  CAFE
  CAMPUS
  COWORKING
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SourceType {
  OFFICIAL
  FIRST_PARTY
  COMMUNITY
  DEVELOPMENT_FIXTURE
}

model StudySpace {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique @db.VarChar(160)
  name        String        @db.VarChar(200)
  description String        @db.Text
  category    SpaceCategory

  address   String?  @db.VarChar(300)
  city      String   @db.VarChar(120)
  region    String   @db.VarChar(120)
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  status     PublicationStatus @default(DRAFT)
  sourceType SourceType
  sourceUrl  String?           @db.Text
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  amenities StudySpaceAmenity[]
  favorites Favorite[]

  @@index([status, category])
  @@index([city])
}

model Amenity {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(60)
  name String @db.VarChar(120)

  spaces StudySpaceAmenity[]
}

model StudySpaceAmenity {
  studySpaceId String @db.Uuid
  amenityId    String @db.Uuid

  studySpace StudySpace @relation(fields: [studySpaceId], references: [id], onDelete: Cascade)
  amenity    Amenity    @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([studySpaceId, amenityId])
}

model Favorite {
  ownerKey     String   @db.VarChar(64)
  studySpaceId String   @db.Uuid
  createdAt    DateTime @default(now())

  studySpace StudySpace @relation(fields: [studySpaceId], references: [id], onDelete: Cascade)

  @@id([ownerKey, studySpaceId])
  @@index([ownerKey, createdAt, studySpaceId])
  @@index([studySpaceId])
}

model AuthSession {
  id        String   @id @db.VarChar(32)
  subject   String   @db.VarChar(255)
  providerSessionId String @db.VarChar(255)
  createdAt Int
  expiresAt DateTime

  @@index([subject])
  @@index([providerSessionId])
  @@index([expiresAt])
}
