# Development placeholders. Use a separate, migrated studyspace_test database for integration tests.
DIRECT_URL=postgresql://migration_owner:replace-me@localhost:5432/studyspace_dev
DATABASE_URL=postgresql://studyspace_app:replace-me@localhost:5432/studyspace_dev
FAVORITES_DATABASE_URL=postgresql://studyspace_saved:replace-me@localhost:5432/studyspace_dev
DATABASE_POOL_MAX=5
PRIVATE_DATABASE_POOL_MAX=5

# Optional for browsing. Required for sign-in and Saved.
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_MODERATOR_SUBJECTS=

# Random 32+ byte secret used only to pseudonymize rate-limit subjects.
RATE_LIMIT_SECRET=
